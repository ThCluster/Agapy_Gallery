# Copier ce fichier en .env et remplir les valeurs. Ne jamais versionner .env.

DEBUG=True
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=a-remplacer
# Clé de signature des jetons JWT, distincte de SECRET_KEY
JWT_SIGNING_KEY=a-remplacer
ALLOWED_HOSTS=localhost,127.0.0.1

# mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL=mysql://agapy_gallery:mot-de-passe@127.0.0.1:3306/agapy_gallery

# Origines autorisées à appeler l'API (frontend Vite en développement)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cookie du jeton de rafraîchissement. En production : True et le domaine du site.
# REFRESH_COOKIE_SECURE=True
# REFRESH_COOKIE_SAMESITE=Lax

# Paiements : simulateur tant qu'aucun prestataire réel n'est branché (voir config/settings.py)
PAYMENT_SIMULATION_ENABLED=True
# FRONTEND_URL=http://localhost:5173

# Envoi des SMS. En développement, les SMS sont affichés dans la console.
# SMS_BACKEND=apps.notifications.sms.ConsoleSmsBackend

# Envoi des e-mails. En développement, ils sont affichés dans la console.
# EMAIL_URL=smtp+tls://utilisateur:mot-de-passe@smtp.exemple.com:587
# DEFAULT_FROM_EMAIL=AGAPY-GALLERY <no-reply@agapy-gallery.com>
