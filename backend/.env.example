# Copier ce fichier en .env et remplir les valeurs. Ne jamais versionner .env.

DEBUG=True
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=a-remplacer
# Clé de signature des jetons JWT, distincte de SECRET_KEY
JWT_SIGNING_KEY=a-remplacer
ALLOWED_HOSTS=localhost,127.0.0.1

# mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL=mysql://agapy_gallery:mot-de-passe@127.0.0.1:3306/agapy_gallery

# Origines autorisées à appeler l'API (frontend Vite en développement)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Nombre de proxys de confiance devant Django (0 en local, 1 derrière nginx) : sert à lire l'IP réelle
# NUM_PROXIES=0

# Chemin de l'administration Django (à changer en production, par ex. gestion-7f3k2/)
# ADMIN_URL=admin/

# Cookie du jeton de rafraîchissement. En production : True et le domaine du site.
# REFRESH_COOKIE_SECURE=True
# REFRESH_COOKIE_SAMESITE=Lax

# Paiements : simulateur tant qu'aucun prestataire réel n'est branché (voir config/settings.py)
PAYMENT_SIMULATION_ENABLED=True
# FRONTEND_URL=http://localhost:5173

# Envoi des SMS. En développement, les SMS sont affichés dans la console.
# SMS_BACKEND=apps.notifications.sms.ConsoleSmsBackend
# SMS_SENDER_NAME=AGAPY
# SMS_TIMEOUT=10
#
# Orange SMS API (Afrique de l'Ouest) :
# SMS_BACKEND=apps.notifications.sms_providers.OrangeSmsBackend
# SMS_ORANGE_CLIENT_ID=...
# SMS_ORANGE_CLIENT_SECRET=...
# SMS_ORANGE_SENDER=2250000000000        # numéro de l'expéditeur, sans « + »
# SMS_ORANGE_SENDER_NAME=AGAPY           # nom affiché (doit être validé par Orange)
#
# Twilio :
# SMS_BACKEND=apps.notifications.sms_providers.TwilioSmsBackend
# SMS_TWILIO_SID=ACxxxxxxxx
# SMS_TWILIO_TOKEN=...
# SMS_TWILIO_FROM=+15550000000
#
# Agrégateur local (API HTTP JSON) :
# SMS_BACKEND=apps.notifications.sms_providers.HttpSmsBackend
# SMS_HTTP_URL=https://sms.exemple.ci/api/send
# SMS_HTTP_HEADERS={"Authorization": "Bearer xxx"}
# SMS_HTTP_TEMPLATE={"to": "{to}", "text": "{message}", "from": "{sender}"}
# SMS_HTTP_SENDER=AGAPY

# Envoi différé des SMS et e-mails : mis en file (chiffrés) puis envoyés par
# « python manage.py send_pending_notifications » lancé chaque minute (cron). Défaut : envoi immédiat.
# NOTIFICATIONS_ASYNC=False

# Envoi des e-mails. En développement, ils sont affichés dans la console.
# EMAIL_URL=smtp+tls://utilisateur:mot-de-passe@smtp.exemple.com:587
# DEFAULT_FROM_EMAIL=AGAPY-GALLERY <no-reply@agapy-gallery.com>

# Clé de chiffrement des données sensibles (coordonnées de versement, notifications en attente).
# OBLIGATOIRE en production, à sauvegarder à part : sans elle, les données chiffrées sont perdues.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation : nouvelle_cle,ancienne_cle (la première chiffre, toutes déchiffrent).
# FIELD_ENCRYPTION_KEY=

# Cache partagé entre les processus (limites de débit, blocages de connexion). En production : Redis.
# CACHE_URL=rediscache://127.0.0.1:6379/1
# Avec mot de passe : CACHE_URL=rediscache://:mot-de-passe@127.0.0.1:6379/1

# --- Production (DEBUG=False) ---
# Origines HTTPS autorisées pour les formulaires (administration), ex. https://agapy-gallery.com
# CSRF_TRUSTED_ORIGINS=https://agapy-gallery.com,https://www.agapy-gallery.com
# Connexions MySQL persistantes (secondes)
# CONN_MAX_AGE=60
# HSTS : 1 an par défaut. Le préchargement (preload) est difficile à annuler : à activer en connaissance de cause.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# SECURE_SSL_REDIRECT=True
# Journaux : niveau et fichier JSON tournant (en plus de la console)
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/agapy/django.log

# Durée réelle des vidéos : ffprobe (paquet ffmpeg) est utilisé s'il est installé
# MEDIA_FFPROBE_ENABLED=True
